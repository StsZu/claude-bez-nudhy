---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Почни за 30 секунд" wide>
  <section class="hero">
    <div>
      <p class="eyebrow">Курс для команди · 8 місій по 5 хвилин</p>
      <h1>Claude без нудьги.<br /><em>Звільни свій час.</em></h1>
      <p class="intro">
        Понеділок. <strong>214 непрочитаних листів</strong>, таблиця з пекла й дедлайн у п'ятницю. Тебе щойно призначили
        ШІ-провідником команди. У тебе 7 днів і Claude.
      </p>
      <div class="cta">
        <a class="primary btn big" id="cta" href={u('lesson/1/')}>Почати за 30 секунд</a>
        <p class="hint">Без реєстрації. Прогрес зберігається на цьому пристрої.</p>
      </div>
    </div>
    <figure class="doors-orbit" aria-labelledby="orbit-cap">
      <div class="orbit-core" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="8" y="4" width="16" height="24" rx="2" /><path d="M4 28h24" /><circle cx="19.5" cy="16.5" r="1.4" fill="currentColor" stroke="none" />
        </svg>
        Claude
      </div>
      <ul>
        <li class="o1"><a href={u('lesson/2/')}><span aria-hidden="true">☰</span>Чат і файли</a></li>
        <li class="o2"><a href={u('lesson/3/')}><span aria-hidden="true">›_</span>Claude Code</a></li>
        <li class="o3"><a href={u('lesson/6/')}><span aria-hidden="true">↻</span>Автопілот</a></li>
        <li class="o4"><a href={u('lesson/5/')}><span aria-hidden="true">⚿</span>Конектори</a></li>
        <li class="o5"><a href={u('lesson/4/')}><span aria-hidden="true">▦</span>Твої програми</a></li>
      </ul>
      <figcaption id="orbit-cap">Одна голова, багато дверей.</figcaption>
    </figure>
  </section>
  <section class="strip page-only" aria-label="Курс у цифрах">
    <p class="num"><strong>8</strong><span>практичних<br />місій</span></p>
    <p class="num"><strong>~40</strong><span>хвилин<br />на весь курс</span></p>
    <div class="bar-wrap">
      <p class="bar-head"><span>Твій маршрут</span><span id="route-text">0 з 8 пройдено</span></p>
      <div class="bar" aria-hidden="true"><span id="route-bar"></span></div>
    </div>
  </section>
  <section class="page-only">
    <div class="section-title">
      <h2>Маленькі місії. <em>Великі зміни.</em></h2>
      <p>Як це працює</p>
    </div>
    <ul class="features">
      <li><strong>Одна місія — 5 хвилин</strong><p>Картка-ідея, коротке демо, 3 питання, одна дія.</p></li>
      <li><strong>Порядок довільний</strong><p>Стрибай до місії, яка цікава саме зараз.</p></li>
      <li><strong>Пропустив день — прогрес на місці</strong><p>Жодних штрафів, повернення нагороджується.</p></li>
      <li><strong>Режим фокусу</strong><p>Ховає все зайве — кнопка «Фокус».</p></li>
    </ul>
    <div class="row">
      <a class="secondary btn" href={u('map/')}>Карта місій</a>
      <a class="secondary btn" href={u('start/')}>Обрати маршрут за роллю</a>
    </div>
    <p class="pledge"><span class="mark" aria-hidden="true">✧</span><span><strong>Тут немає відстаючих.</strong> Пропустив день? Просто продовжуй — наступна маленька перемога вже поруч.</span></p>
  </section>
  <script>
    import { nextLesson } from '../lib/game';
    import { getState, meta, subscribe } from '../scripts/store';
    subscribe((st) => {
      document.getElementById('route-text')!.textContent = `${st.done.length} з 8 пройдено`;
      document.getElementById('route-bar')!.style.width = `${(st.done.length / 8) * 100}%`;
    });
    const s = getState();
    const n = nextLesson(s);
    const cta = document.getElementById('cta') as HTMLAnchorElement;
    if (s.started.length && n) {
      cta.href = meta.lessons[n].url;
      cta.textContent = `Продовжити: місія «${meta.lessons[n].mission}»`;
    } else if (s.started.length && !n) {
      cta.href = meta.progressUrl;
      cta.textContent = 'Усі місії пройдено — мій прогрес';
    }
  </script>
</Base>
