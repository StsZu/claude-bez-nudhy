# Скопіюй у .env і заповни. .env не потрапляє в git.
# Токен від @BotFather (потрібен дозвіл власника, див. README).
BOT_TOKEN=
# Базова адреса сайту курсу, без скісної риски в кінці.
SITE_URL=https://example.com
# Шлях або URL до course.json (наприклад, https://example.com/course.json або ../web/dist/course.json).
COURSE_JSON=../web/dist/course.json
# Файл бази SQLite.
DB_PATH=./data/bot.sqlite3
# Остання вдала копія course.json (за замовчуванням — поруч із базою).
COURSE_CACHE_PATH=./data/course.cache.json
# Часовий пояс розсилки.
TZ_NAME=Europe/Kyiv
